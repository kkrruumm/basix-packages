pkg_name=xdg-desktop-portal-termfilechooser
version=1.5.0
revision=1
build_style=meson
short_desc="xdg-desktop-portal backend for terminal file choosers"
home_page="https://github.com/hunkyburrito/xdg-desktop-portal-termfilechooser"
license="MIT"
dist_files="https://github.com/hunkyburrito/xdg-desktop-portal-termfilechooser/archive/v${version}.tar.gz>xdg-desktop-portal-termfilechooser-${version}.tar.gz"
checksum="5a855da31ad86a949d80cf66545beab30bc32ed029f3544b9ac73476b3dc98e5"

use_flags="man"

depends="basu inih xdg-desktop-portal"
make_depends="basu inih meson pkgconf $(use_if man scdoc)"

configure_args="
    -Dsd-bus-provider=basu
    -Dsystemd=disabled
    $(use_if man -Dman-pages=enabled -Dman-pages=disabled)"

post_install() {
    brm /usr/share/xdg-desktop-portal-termfilechooser/systemd
}
