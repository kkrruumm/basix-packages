pkg_name=sshfs
version=3.7.7
revision=1
build_style=meson
short_desc="FUSE filesystem client based on the SSH File Transfer Protocol"
home_page="https://github.com/libfuse/sshfs"
license="GPL-2.0-only"
dist_files="https://github.com/libfuse/sshfs/releases/download/sshfs-${version}/sshfs-${version}.tar.xz"
checksum="2a9a17259cc71e17268817ab0896153afe5fdbe43782b14b09e50c3b3c9d6a82"
wrk_src="sshfs-$version"

depends="fuse3 glib openssh"
make_depends="fuse3 glib meson pkgconf $(use_if man python-docutils)"

use_flags="man"

configure_args="-Dsbindir=bin"

pre_configure() {
    # this just replaces busybox incompatible ln with a compatible invocation
    cat > utils/install_helper.sh <<-'EOF'
	#!/bin/sh
	set -e
	sbindir="$1"
	prefix="${MESON_INSTALL_DESTDIR_PREFIX}"
	mkdir -p "${prefix}/${sbindir}"
	ln -sf sshfs "${prefix}/${sbindir}/mount.sshfs"
	ln -sf sshfs "${prefix}/${sbindir}/mount.fuse.sshfs"
	EOF
}

post_install() {
    blicense COPYING
}
