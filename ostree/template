pkg_name=ostree
version=2026.1
revision=1
build_style=gnu-configure
short_desc="Git-like content addressed filesystem tree store"
home_page="https://github.com/ostreedev/ostree"
license="LGPL-2.0-or-later"
dist_files="https://github.com/ostreedev/ostree/releases/download/v${version}/libostree-${version}.tar.xz"
checksum="ee3661a0579aa430b1b57e8754fbfa5d8575d1e72ea0dda294a03062b9013b4b"
wrk_src="libostree-$version"

use_flags="fuse man"
use_default="+fuse +man"

depends="curl e2fsprogs glib gpgme libarchive openssl util-linux xz zlib
 $(use_if fuse fuse3)"
make_depends="bison curl e2fsprogs glib gpgme libarchive openssl pkgconf python
 util-linux xz zlib
 $(use_if fuse fuse3)
 $(use_if man "docbook-xsl libxslt")"

configure_args="
    --disable-static
    --disable-glibtest
    --disable-gtk-doc
    --disable-introspection
    --with-curl
    --with-openssl
    --with-libarchive
    --without-soup3
    --without-libsystemd
    --without-composefs
    --without-selinux
    --without-avahi
    --with-libmount
    $(use_if fuse --enable-rofiles-fuse --disable-rofiles-fuse)
    $(use_if man --enable-man --disable-man)"

pre_configure() {
    export XML_CATALOG_FILES=/usr/share/xsl/docbook/catalog.xml
}