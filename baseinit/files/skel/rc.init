#!/bin/sh
#
# stage 2, s6-svscan is already running as pid 1 on /run/service and the
# catch-all logger is up, everything printed here is logged and also hits
# /dev/console if S6_INIT_CONSOLE is on
#
# only the things that have to happen before a service manager exists belong
# here, everything else is an s6-rc service

rl=$1
shift

. /usr/lib/s6-rc/rc.lib

log "welcome to basix!"

log "mounting pseudo filesystems..."; {
    mnt nosuid,noexec,nodev proc  proc /proc
    mnt nosuid,noexec,nodev sysfs sys  /sys

    # /run is already a tmpfs, s6-linux-init mounted it and unpacked the
    # run-image into it before execing into s6-svscan
    mkdir -p /run/user /run/lock /dev/pts /dev/shm

    mnt mode=0620,gid=5,nosuid,noexec devpts devpts /dev/pts
    mnt mode=1777,nosuid,nodev tmpfs shm /dev/shm

    {
        ln -s /proc/self/fd /dev/fd
        ln -s fd/0 /dev/stdin
        ln -s fd/1 /dev/stdout
        ln -s fd/2 /dev/stderr
    } 2>/dev/null
}

log "starting the service manager..."; {
    s6-rc-init -c /etc/s6-rc/compiled/current -l /run/s6-rc /run/service || sos
}

log "entering runlevel $rl..."; {
    exec /etc/s6-linux-init/current/scripts/runlevel "$rl"
}
