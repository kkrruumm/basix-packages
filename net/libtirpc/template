pkg_name=libtirpc
version=1.3.7
revision=1
build_style=gnu-configure
short_desc="Transport independent RPC library, the sunrpc replacement"
home_page="https://sourceforge.net/projects/libtirpc"
license="BSD-3-Clause"
dist_files="https://downloads.sourceforge.net/libtirpc/libtirpc-${version}.tar.bz2"
checksum="9666e4c026181a5278a395f8a60b95f412e3e2679384071f4e59b26845c5f375"

use_flags="ipv6 -gssapi -authdes -static"
make_depends="bsd-compat-headers linux-headers pkgconf"

configure_args="
    $(use_if gssapi --enable-gssapi --disable-gssapi)
    $(use_if authdes --enable-authdes --disable-authdes)
    $(use_if ipv6 --enable-ipv6 --disable-ipv6)
    $(use_if static --enable-static --disable-static)"

post_install() {
    blicense COPYING
}
