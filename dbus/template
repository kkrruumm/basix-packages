pkg_name=dbus
version=1.16.2
revision=1
build_style=cmake # at some point should probably switch to meson for this but fuck it
short_desc="Freedesktop.org message bus system"
home_page="https://www.freedesktop.org/wiki/Software/dbus"
license="AFL-2.1 OR GPL-2.0-or-later"
dist_files="https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz"
checksum="b1d1f22858a8f04665e5dca29d194f892620f00fd3e3f4e89dd208e78868436e"
depends="expat"
make_depends="cmake expat"

system_accounts="messagebus"
messagebus_uid=22
messagebus_gid=22
messagebus_descr="D-Bus system message bus"
messagebus_homedir="/var/lib/dbus"

use_flags="services"
use_default="+services"

configure_args="
    -DCMAKE_INSTALL_RUNSTATEDIR=/run
    -DDBUS_SESSION_SOCKET_DIR=/tmp
    -DENABLE_SYSTEMD=OFF
    -DENABLE_USER_SESSION=OFF
    -DENABLE_TRADITIONAL_ACTIVATION=ON
    -DDBUS_BUILD_TESTS=OFF
    -DDBUS_WITH_GLIB=OFF
    -DDBUS_ENABLE_XML_DOCS=OFF
    -DDBUS_ENABLE_DOXYGEN_DOCS=OFF
    -DDBUS_DISABLE_ASSERT=ON"

post_install() {
    bmkdir /var/lib/dbus

    # as of 1.16 the build no longer sets this itself
    if [ -f "$DESTDIR/usr/libexec/dbus-daemon-launch-helper" ]; then
        chmod 4755 "$DESTDIR/usr/libexec/dbus-daemon-launch-helper"
    fi

    if use services; then
        binstall "$FILESDIR/dbus.run" 0755 /etc/sv/dbus run
        bln /run/runit/supervise.dbus /etc/sv/dbus/supervise
    fi
}