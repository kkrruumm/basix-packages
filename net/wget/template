pkg_name=wget
version=1.25.0
revision=2
build_style=gnu-configure
short_desc="Non-interactive network downloader"
home_page="https://www.gnu.org/software/wget"
license="GPL-3.0-or-later"
dist_files="https://ftp.gnu.org/gnu/wget/wget-${version}.tar.gz"
checksum="be2581f92173acf6d7e74f0c167b5c59da21b1f44a468b4608dd243a10c0857e"
depends="libressl util-linux zlib"
make_depends="libressl perl util-linux zlib"

use_flags="ssl ipv6 -nls -iri -psl -pcre2 -metalink uuid static"

# everything optional here is autodetected, so anything not pinned changes the
# resulting binary depending on what happens to be installed at build time
configure_args="
    $(use_if ssl --with-ssl=openssl --without-ssl)
    --with-zlib
    $(use_enable ipv6)
    $(use_enable nls)
    $(use_enable iri)
    $(use_with psl libpsl)
    $(use_with metalink)
    $(use_with uuid libuuid)
    $(use_enable pcre2)
    --disable-pcre"

pre_configure() {
    use static || return 0
    LDFLAGS="$LDFLAGS -static"
    export LDFLAGS
}

post_install() {
    brm /usr/share/info
}
