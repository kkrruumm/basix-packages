pkg_name=gnupg
version=2.5.24
revision=1
build_style=gnu-configure
short_desc="GNU Privacy Guard, a complete OpenPGP implementation"
home_page="https://gnupg.org"
license="GPL-3.0-or-later"
dist_files="https://gnupg.org/ftp/gcrypt/gnupg/gnupg-${version}.tar.bz2"
checksum="f8a66bee2415fc0e293ae10b17a89c708ac32b9a1c2379d28ed9508001fd7b18"

use_flags="tls"

depends="bzip2 libassuan libgcrypt libgpg-error libksba npth sqlite zlib
 $(use_if tls gnutls)"
make_depends="bzip2 libassuan libgcrypt libgpg-error libksba npth pkgconf sqlite zlib
 $(use_if tls gnutls)"

configure_args="
    --disable-nls
    --enable-tofu
    --disable-card-support
    --disable-ccid-driver
    --disable-ldap
    --disable-ntbtls
    --disable-photo-viewers
    --disable-tests
    --enable-zip
    --enable-bzip2
    $(use_if tls --enable-gnutls --disable-gnutls)"
