LibreSSL has no scrypt and no XOF digests, so hashlib will not build against
it unmodified. PY_OPENSSL_HAS_SCRYPT is defined unconditionally rather than
feature tested like its neighbours, and the XOF branch in EVP_new_impl() is
the one use of EVPXOFtype that is not already inside PY_OPENSSL_HAS_SHAKE.

SHA-3 has been present since LibreSSL 3.8, so hashlib keeps sha3_* through
libcrypto. blake2 and shake fall back to CPython's own HACL* code, and
hashlib.scrypt goes away.

The configure probe hardcodes NID_blake2b512 and EVP_PBE_scrypt, so it has
to be answered with ac_cv_working_openssl_hashlib=yes, see the template.

--- a/Modules/_hashopenssl.c
+++ b/Modules/_hashopenssl.c
@@ -44,7 +44,9 @@
 
 #define MUNCH_SIZE INT_MAX
 
+#ifndef OPENSSL_NO_SCRYPT
 #define PY_OPENSSL_HAS_SCRYPT 1
+#endif
 #if defined(NID_sha3_224) && defined(NID_sha3_256) && defined(NID_sha3_384) && defined(NID_sha3_512)
 #define PY_OPENSSL_HAS_SHA3 1
 #endif
@@ -963,11 +965,15 @@
         goto exit;
     }
 
+#ifdef PY_OPENSSL_HAS_SHAKE
     if ((EVP_MD_flags(digest) & EVP_MD_FLAG_XOF) == EVP_MD_FLAG_XOF) {
         type = get_hashlib_state(module)->EVPXOFtype;
     } else {
         type = get_hashlib_state(module)->EVPtype;
     }
+#else
+    type = get_hashlib_state(module)->EVPtype;
+#endif
 
     self = newEVPobject(type);
     if (self == NULL) {
