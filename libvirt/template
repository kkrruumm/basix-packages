pre_build() {
    # the protocol and keycode table gens are racey
    # and eat shit with a parallel ninja build, thank you void template
    ninja -C build \
        src/remote/lxc_protocol.h \
        src/remote/qemu_protocol.h \
        src/remote/remote_protocol.h \
        src/util/virkeycodetable_linux.h \
        src/util/virkeycodetable_osx.h \
        src/util/virkeycodetable_win32.h \
        src/util/virkeynametable_linux.h \
        src/util/virkeynametable_osx.h \
        src/util/virkeynametable_win32.h
}

post_install() {
    # basix is no polkit so the libvirt group is used
    bsed 's|^#unix_sock_group = .*|unix_sock_group = "libvirt"|' \
        "$DESTDIR/etc/libvirt/libvirtd.conf"
    bsed 's|^#unix_sock_rw_perms = .*|unix_sock_rw_perms = "0770"|' \
        "$DESTDIR/etc/libvirt/libvirtd.conf"
    bsed 's|^#auth_unix_rw = .*|auth_unix_rw = "none"|' \
        "$DESTDIR/etc/libvirt/libvirtd.conf"

    # musl ships no utmpx, so libvirts owner remembering does not work
    printf '\n# musl has no utmpx implementation\nremember_owner = 0\n' \
        >> "$DESTDIR/etc/libvirt/qemu.conf"

    # meson does not create the state directories the drivers expect
    bmkdir /var/lib/libvirt/boot
    bmkdir /var/lib/libvirt/dnsmasq
    bmkdir /var/lib/libvirt/images
    bmkdir /var/lib/libvirt/network
    bmkdir /var/lib/libvirt/qemu/channel/target
    bmkdir /var/lib/libvirt/qemu/nvram
    bmkdir /var/cache/libvirt/qemu

    brm /etc/sysconfig
    brm /var/log

    if ! use doc; then
        brm /usr/share/doc/libvirt/html
    fi

    bcopy "$FILESDIR/sources/." /usr/share/s6-rc/sources
    find "$DESTDIR/usr/share/s6-rc/sources" -type f -name run -exec chmod 0755 {} +
}
