pkg_name=util-linux
version=2.42.4
revision=2
build_style=gnu-configure
short_desc="Miscellaneous Linux system utilities"
home_page="https://github.com/util-linux/util-linux"
license="GPL-2.0-only, LGPL-2.1-or-later, BSD-3-Clause"
dist_files="https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-${version}.tar.xz"
checksum="f469475f55e55cb26253f2e106363523dbe5a5d48fc97780eee4c6864df23d2f"

depends="zlib"
make_depends="linux-headers zlib"

use_flags="-udev -python -systemd -nls -getty-symlink -doc -completions"

configure_args="
    --enable-libuuid
    --enable-libblkid
    --enable-fsck
    --enable-chfn-chsh
    --disable-chfn-chsh-password
    --disable-liblastlog2
    --disable-makeinstall-chown
    --disable-rpath
    $(use_enable nls)
    $(use_with udev)
    $(use_with python)
    $(use_with systemd)"

post_install() {
    if use getty-symlink; then
        bln agetty /usr/bin/getty
        bln agetty.8 /usr/share/man/man8/getty.8
    fi

    use doc || brm /usr/share/doc
    use completions || brm /usr/share/bash-completion
}
