configure_args="
    --enable-pinentry-tty
    --enable-pinentry-curses
    --enable-fallback-curses
    --disable-pinentry-qt5
    --disable-pinentry-gtk2
    --disable-pinentry-gnome3
    --disable-pinentry-fltk
    --disable-pinentry-emacs
    --disable-libsecret"

post_install() {
    blicense COPYING
}
