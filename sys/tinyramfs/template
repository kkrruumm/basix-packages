pkg_name=tinyramfs
version=0.3.0
revision=3
build_style=custom
short_desc="Tiny initramfs generator"
home_page="https://github.com/illiliti/tinyramfs"
license="MIT"
dist_files="https://github.com/illiliti/tinyramfs/archive/refs/tags/${version}.tar.gz>tinyramfs-${version}.tar.gz"
checksum="f39774ad465cc3bba9eeda604dd9f7033c6574436795c3dbc7c3c431601a456537"

do_build() { :; }

do_install() {
    $make_cmd PREFIX=/usr DESTDIR="$DESTDIR" install

    binstall "$FILESDIR/config" 0644 /etc/tinyramfs

    binstall "$FILESDIR/hooks/post-install" 0755 /etc/bpm/hooks/post-install 20-initramfs
    binstall "$FILESDIR/hooks/post-remove" 0755 /etc/bpm/hooks/post-remove 20-initramfs
}
