# todo: find or make a replacement for this dogshit stack
pkg_name=libvirt
version=12.7.0
revision=1
build_style=meson
short_desc="Virtualization API for controlling virtualization engines"
home_page="https://libvirt.org"
license="LGPL-2.1-or-later"
dist_files="https://libvirt.org/sources/libvirt-${version}.tar.xz"
checksum="2c0c6f20cc9f2afebacca8c1196bf56e057be96a45383d23fdf85d522596612c"

patch_args="-p0"

# readline isnt packaged atm so virsh has no line editing
# no libattr so the xattr sec labeling is off
# docs are manpages, they need python-docutils and xsltproc
use_flags="qemu network storage udev man -doc -lvm -nls -sasl -numa"

depends="dmidecode glib gnutls json-c libcap-ng libnl libpciaccess libtirpc
 libxml2 libxslt lvm2
 $(use_if qemu qemu)
 $(use_if udev libudev-zero)"

make_depends="glib gnutls json-c libcap-ng libnl libpciaccess libtirpc libxml2
 libxslt linux-headers lvm2 meson perl pkgconf python
 $(use_if docs python-docutils)
 $(use_if nls gettext-tiny)
 $(use_if udev libudev-zero)"

system_accounts="libvirt"
libvirt_uid=61
libvirt_gid=61
libvirt_descr="libvirt qemu instances"
libvirt_homedir="/var/lib/libvirt"
libvirt_groups="kvm disk"

