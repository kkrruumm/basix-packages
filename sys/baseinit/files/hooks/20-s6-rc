#!/bin/sh
# args: <pkg_name> <root>/ <version>
root=${2%/}; root=${root%/}
in_root() { if [ -n "$root" ]; then chroot "$root" "$@"; else "$@"; fi; }

[ -d "$root/usr/share/s6-rc/sources" ] || exit 0

if [ -d "$root/var/lib/s6-rc/repository" ]; then
    in_root s6 repository sync
else
    in_root s6 repository init
fi || exit 1
in_root s6 set commit || exit 1

if [ -z "$root" ] && [ -d /run/s6-rc ]; then
    s6 live install -b
else
    in_root s6 live install --init
fi
