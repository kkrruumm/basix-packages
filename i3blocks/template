pkg_name=i3blocks
version=1.5
revision=1
build_style=gnu-configure
short_desc="Minimalist scheduler for status line scripts"
home_page="https://github.com/vivien/i3blocks"
license="GPL-3.0-or-later"
dist_files="https://github.com/vivien/i3blocks/archive/${version}.tar.gz>i3blocks-${version}.tar.gz"
checksum="cc370482bd23bbe60cfb5769e537635b5f6724ceae7a676b4f7fd209cc515196"
wrk_src="i3blocks-$version"

use_flags="man"

make_depends="autoconf automake m4 perl pkgconf"
make_install_args="-j1"

pre_configure() {
    autoreconf -fi
}

post_install() {
    brm /usr/share/bash-completion

    if ! use man; then
        brm /usr/share/man
    fi
}
