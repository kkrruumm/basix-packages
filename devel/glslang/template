pkg_name=glslang
version=16.6.0
revision=1
build_style=cmake
short_desc="Khronos reference front end for GLSL, ESSL and SPIR-V"
home_page="https://github.com/KhronosGroup/glslang"
license="BSD-3-Clause, MIT, Apache-2.0"
dist_files="https://github.com/KhronosGroup/glslang/archive/${version}.tar.gz>glslang-${version}.tar.gz"
checksum="acdee1ad26de6bb4f36f5b046483b73da92785ab6d55652cb611800ebe60a5ad"
depends="spirv-tools"
make_depends="cmake python spirv-tools"

pre_configure() {
    LDFLAGS="$LDFLAGS -Wl,-z,stack-size=2097152"
    export LDFLAGS
}

configure_args="
    -DALLOW_EXTERNAL_SPIRV_TOOLS=ON
    -DBUILD_SHARED_LIBS=ON
    -DENABLE_CTEST=OFF
    -DGLSLANG_TESTS=OFF"
