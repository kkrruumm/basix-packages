configure_args="
    --with-features=huge
    --enable-multibyte
    --disable-gui
    --without-x
    --disable-gtktest
    --disable-netbeans
    --disable-canberra
    --disable-selinux
    --disable-acl
    --disable-nls
    $(use_if python --enable-python3interp=dynamic --disable-python3interp)"
