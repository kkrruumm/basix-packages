pkg_name=zstd
version=1.5.7
revision=2
build_style=gnu-makefile
short_desc="Fast real time compression algorithm"
home_page="https://facebook.github.io/zstd"
license="BSD-3-Clause OR GPL-2.0-only"
dist_files="https://github.com/facebook/zstd/releases/download/v${version}/zstd-${version}.tar.gz"
checksum="730dca31244abd219e995f03a55d95b2cfb4b3e16cda055a79fa6f30a4f0e1db8f"

use_flags="-lz4 -zlib -lzma"

depends="$(use_if lz4 lz4)
  $(use_if zlib zlib)
  $(use_if lzma xz)"
make_depends="$(use_if lz4 lz4)
  $(use_if zlib zlib)
  $(use_if lzma xz)"

make_build_args="$(use_if lz4 HAVE_LZ4=1 HAVE_LZ4=0) $(use_if zlib HAVE_ZLIB=1 HAVE_ZLIB=0) $(use_if lzma HAVE_LZMA=1 HAVE_LZMA=0)"
