pkg_name=tmux
version=3.8
revision=1
build_style=gnu-configure
short_desc="Terminal multiplexer"
home_page="https://tmux.github.io"
license="ISC"
dist_files="https://github.com/tmux/tmux/releases/download/${version}/tmux-${version}.tar.gz"
checksum="f948bad3444dac126da9f4d9cd8ea92856dbed6bdc2435ef4053bb2113f66df4"

# if you want emojis for some reason or CJK fonts, enable utf8proc
use_flags="-utf8proc sixel man doc -static"

depends="libevent ncurses
 $(use_if utf8proc libutf8proc)"
make_depends="bison libevent ncurses pkgconf
 $(use_if utf8proc libutf8proc)"

configure_args="
    $(use_enable utf8proc)
    $(use_enable sixel)
    $(use_enable static)
    --disable-utempter
    --disable-systemd
    --disable-cgroups
    --disable-jemalloc
    --disable-debug"

pre_configure() {
    YACC="bison -y"
    export YACC
}

post_install() {
    use man || brm /usr/share/man/man1/tmux.1

    use doc || return 0
    bdoc example_tmux.conf
    bdoc CHANGES
}
