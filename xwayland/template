# this is another package that fucking sucked, btw
pkg_name=xwayland
version=24.1.13
revision=1
build_style=meson
short_desc="X server that runs rootless inside a Wayland compositor"
home_page="https://gitlab.freedesktop.org/xorg/xserver"
license="MIT"
dist_files="https://www.x.org/releases/individual/xserver/xwayland-${version}.tar.xz"
checksum="76ca3242b88a794e0b7c6104e1833e813788b45a0090abc43ef060205ff95375"
use_flags="glamor listen_tcp"
use_default="+glamor -listen_tcp"

depends="libdrm libXfont2 libxcvt libxshmfence mesa openssl pixman wayland
 xkbcomp xkeyboard-config $(use_if glamor libepoxy)"
make_depends="libdrm libXfont2 libxcvt libxkbfile libxshmfence mesa openssl
 pixman wayland xorgproto xtrans $(use_if glamor libepoxy)"
host_make_depends="font-util meson pkgconf python wayland-protocols"

configure_args="
    -Dxdmcp=false
    -Dsecure-rpc=false
    -Dsha1=libcrypto
    -Ddri3=true
    -Dglx=true
    -Dxkb_dir=/usr/share/X11/xkb
    -Dxkb_bin_dir=/usr/bin
    -Dxkb_output_dir=/var/lib/xkb
    $(use_if glamor -Dglamor=true -Dglamor=false)
    $(use_if listen_tcp -Dlisten_tcp=true -Dlisten_tcp=false)"

post_install() {
    bmkdir -m 0755 /var/lib/xkb
}