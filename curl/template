pkg_name=curl
version=8.21.0
revision=1
build_style=gnu-configure
short_desc="Command line URL transfer tool"
home_page="https://curl.se"
license="curl"
dist_files="https://curl.haxx.se/download/curl-${version}.tar.xz"
checksum="38e77a6e73698e5390c0acfa441ce7b6d15e6cb2b07efea8f12087a08543ed5bb2"
depends="openssl zlib"
make_depends="openssl zlib"

use_flags="ipv6 ssl -ldap -ares -psl -idn -brotli -zstd static"

configure_args="
    ac_cv_path_PERL=true
    $(use_enable ipv6)
    --enable-unix-sockets
    --enable-symbol-hiding
    --disable-manual
    $(use_enable ldap)
    $(use_enable ares)
    $(use_with ssl openssl)
    --with-pic
    --with-ca-fallback
    --without-librtmp
    $(use_with psl libpsl)
    $(use_with idn libidn2)
    $(use_with brotli)
    $(use_with zstd)"

pre_configure() {
    # upstream broke static linking of the curl binary, keep the shared
    # library intact and force -all-static for the command only
    # https://github.com/curl/curl/issues/7475
    use static && bsed 's/\(curl_LDADD =\)/\1 -all-static/' src/Makefile.in

    # ship the pre-generated manual pages so no perl is needed
    cp -Rf "$FILESDIR"/docs/. docs/
}
