# largely a port from kiss community
pkg_name=lua
version=5.5.1
revision=1
build_style=custom
short_desc="Powerful, efficient, lightweight, embeddable scripting language"
home_page="https://www.lua.org"
license="MIT"
dist_files="https://www.lua.org/ftp/lua-${version}.tar.gz"
checksum="634db1ca64e6ee891a248a837d42b18f236fe8915a8ee2475b3469a9e86805ef"
make_depends="pkgconf"

use_flags="shared dlopen"

pre_build() {
    bsed 's|"/usr/local/"|"/usr/"|' src/luaconf.h

    if grep -q '/usr/local/' src/luaconf.h; then
        die "lua: LUA_ROOT rewrite failed, luaconf.h layout changed"
    fi
}

do_build() {
    $make_cmd $make_jobs -C src all \
        CC="$CC" \
        MYCFLAGS="$CFLAGS -fPIC" \
        MYLDFLAGS="$LDFLAGS" \
        SYSCFLAGS="$(use_if dlopen -DLUA_USE_LINUX -DLUA_USE_POSIX)" \
        SYSLIBS="$(usev dlopen '-Wl,-E -ldl')"

    if use shared; then
        $CC -shared -Wl,-soname,"liblua.so.${version%.*}" \
            -o "src/liblua.so.$version" \
            -Wl,--whole-archive src/liblua.a -Wl,--no-whole-archive \
            $LDFLAGS -lm $(usev dlopen -ldl)
    fi
}

do_install() {
    $make_cmd install \
        INSTALL_TOP="$DESTDIR/usr" \
        INSTALL_MAN="$DESTDIR/usr/share/man/man1"

    if use shared; then
        binstall "src/liblua.so.$version" 0755 /usr/lib
        bln "liblua.so.$version" "/usr/lib/liblua.so.${version%.*}"
        bln "liblua.so.$version" /usr/lib/liblua.so
    fi

    # the two directories baked into package.path and package.cpath
    bmkdir "/usr/share/lua/${version%.*}" "/usr/lib/lua/${version%.*}"
}

post_install() {
    binstall "$FILESDIR/lua.pc" 0644 /usr/lib/pkgconfig
    bsed "s|@V@|${version%.*}|g;s|@R@|$version|g" \
        "$DESTDIR/usr/lib/pkgconfig/lua.pc"

    # names other build systems look for
    bln lua.pc "/usr/lib/pkgconfig/lua${version%.*}.pc"
    bln lua.pc "/usr/lib/pkgconfig/lua-${version%.*}.pc"

    # the license is the last section of the manual, there is no COPYING file
    blicense doc/readme.html
}
