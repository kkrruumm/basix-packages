pkg_name=virt-viewer
version=11.0
revision=3
build_style=meson
short_desc="Graphical console client for virtual machines"
home_page="https://virt-manager.org"
license="GPL-2.0-or-later"
dist_files="https://gitlab.com/virt-viewer/virt-viewer/-/archive/v${version}/virt-viewer-v${version}.tar.gz"
checksum="3e7b6f409e5034772175582e98a5d765b4a1ac66a991ea04fbe3aac624087bb1"
wrk_src="virt-viewer-v${version}"

use_flags="libvirt spice -vnc -ovirt -vte"

depends="glib gtk3 libxml2
 $(use_if libvirt "libvirt libvirt-glib")
 $(use_if spice spice-gtk)
 $(use_if vnc gtk-vnc)"
make_depends="gettext-tiny glib gtk3 libxml2 meson perl pkgconf
 $(use_if libvirt "libvirt libvirt-glib")
 $(use_if spice "spice-gtk spice-protocol xorgproto")
 $(use_if vnc gtk-vnc)"

configure_args="
    -Dbash_completion=disabled
    $(use_if libvirt -Dlibvirt=enabled -Dlibvirt=disabled)
    $(use_if ovirt -Dovirt=enabled -Dovirt=disabled)
    $(use_if spice -Dspice=enabled -Dspice=disabled)
    $(use_if vnc -Dvnc=enabled -Dvnc=disabled)
    $(use_if vte -Dvte=enabled -Dvte=disabled)"

post_install() {
    blicense COPYING
}
