#!/bin/sh
# rootfs read-write, then everything else in fstab
. /usr/lib/nitro/rc.lib
case $1 in
up)
    log "remounting rootfs read-write..."
    mount -o remount,rw / || sos
    log "mounting local filesystems..."
    # no_netdev because there is no network at this point in the boot and a
    # network mount in fstab would block
    mount -a -O no_netdev || sos
    ;;
down)
    sync
    log "unmounting filesystems..."
    umount -a -r || :
    sync
    ;;
esac
exit 0
