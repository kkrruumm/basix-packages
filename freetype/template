pkg_name=freetype
version=2.14.3
revision=1
build_style=gnu-configure
short_desc="Font rendering engine and library"
home_page="https://freetype.org"
license="FTL OR GPL-2.0-or-later"
dist_files="https://download-mirror.savannah.gnu.org/releases/freetype/freetype-${version}.tar.xz"
checksum="0c791e2ea02be6e3cddd6e69ee84d66d869190e5275d8a34e282517769f1192ef9"
depends="bzip2 libpng zlib"
make_depends="bzip2 libpng zlib"

use_flags="brotli harfbuzz"
use_default="-brotli -harfbuzz"

configure_args="
    --enable-freetype-config
    --with-bzip2
    --with-png
    --with-zlib
    $(use_if brotli --with-brotli --without-brotli)
    $(use_if harfbuzz --with-harfbuzz --without-harfbuzz)"