pkg_name=wlroots
version=0.20.2
revision=1
build_style=meson
short_desc="Modular Wayland compositor library"
home_page="https://gitlab.freedesktop.org/wlroots/wlroots"
license="MIT"
dist_files="https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/${version}/wlroots-${version}.tar.gz"
checksum="5812b8dae8def8d503f7e74a1db5e331fa4bced625b653169add94d5c80bc43d"
use_flags="vulkan -xwayland"

# lcms2 comes from -Dcolor-management=enabled, and both end up in the Requires
# of wlroots.pc, so anything linking wlroots needs them present as well
# i'm leaving these comments here as an example of conditional dependencies based on use
depends="lcms2 libdisplay-info libdrm libinput libudev-zero libxkbcommon mesa pixman
 seatd wayland $(use_if vulkan vulkan-loader)
 $(use_if xwayland "libxcb xcb-util-wm xwayland")"
make_depends="hwdata lcms2 libdisplay-info libdrm libinput libudev-zero libxkbcommon
 mesa meson pixman pkgconf seatd wayland wayland-protocols
 $(use_if vulkan "glslang vulkan-headers vulkan-loader")
 $(use_if xwayland "libxcb xcb-util-wm xwayland xorgproto")"

configure_args="
    $(use_if xwayland -Dxwayland=enabled -Dxwayland=disabled)
    -Dbackends=drm,libinput
    -Dallocators=gbm
    -Dexamples=false
    -Dxcb-errors=disabled
    -Dsession=enabled
    -Dcolor-management=enabled
    -Dlibliftoff=disabled
    $(use_if vulkan -Drenderers=gles2,vulkan -Drenderers=gles2)"
