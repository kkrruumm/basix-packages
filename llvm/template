pkg_name=llvm
version=21.1.7
revision=2
build_style=cmake
short_desc="Low level virtual machine compiler infrastructure"
home_page="https://llvm.org"
license="Apache-2.0 WITH LLVM-exception"
dist_files="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${version}.tar.gz>llvm-${version}.tar.gz"
checksum="f2770e2de83b8dcf045ccf53271e85dc00afa1ee8f770379439b4300e76a5baa"

wrk_src="llvm-project-llvmorg-$version/llvm"
patch_args="-p2"

depends="zlib"
make_depends="cmake python zlib"

# one flag per llvm code generation backend, the host's own is always built
# all-targets is the shorthand for every one of them, which is what zig wants,
# it checks llvm-config --targets-built and refuses anything less
# the five experimental backends (ARC, CSKY, DirectX, M68k, Xtensa) are not here
use_flags="aarch64 amdgpu arm avr bpf hexagon lanai loongarch mips msp430
 nvptx powerpc riscv sparc spirv systemz ve webassembly x86 xcore
 all-targets"

use_default="-aarch64 -amdgpu -arm -avr -bpf -hexagon -lanai -loongarch -mips
 -msp430 -nvptx -powerpc -riscv -sparc -spirv -systemz -ve -webassembly -x86
 -xcore +all-targets"

configure_args="
    -DLLVM_BUILD_LLVM_DYLIB=ON
    -DLLVM_LINK_LLVM_DYLIB=ON
    -DLLVM_ENABLE_RTTI=ON
    -DLLVM_INCLUDE_BENCHMARKS=OFF
    -DLLVM_INCLUDE_EXAMPLES=OFF
    -DLLVM_INCLUDE_DOCS=OFF
    -DLLVM_INCLUDE_TESTS=OFF
    -DLLVM_ENABLE_TERMINFO=OFF
    -DLLVM_ENABLE_LIBXML2=OFF
    -Wno-dev"

pre_configure() {
    # config-ix.cmake swaps host for the native arch and then dedupes, so
    # host sitting next to an explicit x86 costs nothing
    _targets=host

    if use all-targets; then
        _targets=all
    else
        for _t in aarch64:AArch64 amdgpu:AMDGPU arm:ARM avr:AVR bpf:BPF \
                  hexagon:Hexagon lanai:Lanai loongarch:LoongArch mips:Mips \
                  msp430:MSP430 nvptx:NVPTX powerpc:PowerPC riscv:RISCV \
                  sparc:Sparc spirv:SPIRV systemz:SystemZ ve:VE \
                  webassembly:WebAssembly x86:X86 xcore:XCore; do
            if use "${_t%:*}"; then _targets="$_targets;${_t#*:}"; fi
        done
    fi

    configure_args="$configure_args
        -DLLVM_TARGETS_TO_BUILD=$_targets
        -DLLVM_HOST_TRIPLE=$(${CC:-cc} -dumpmachine)"
}