pkg_name=dialog
version=1.3.20260107
revision=1
build_style=gnu-configure
short_desc="Display dialog boxes from shell scripts"
home_page="https://invisible-island.net/dialog/"
license="LGPL-2.1-only"
_distver=${version%.*}
_date=${version##*.}
dist_files="https://invisible-mirror.net/archives/dialog/dialog-${_distver}-${_date}.tgz"
checksum="5b07a10daf78f59f6131c696752962053c767bdfe75ba9910cd25926842f9f7d"
wrk_src="dialog-${_distver}-${_date}"
depends="ncurses"
make_depends="ncurses pkgconf"

use_flags="man"

configure_args="--with-ncursesw --disable-nls"

post_install() {
    brm /usr/lib

    if ! use man; then
        brm /usr/share/man/man1/dialog.1
    fi
}