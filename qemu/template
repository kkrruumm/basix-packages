    --disable-virglrenderer
    --disable-virtfs
    --disable-vnc-sasl
    --disable-vte
    --disable-xen
    $(use_if aio --enable-linux-aio --disable-linux-aio)
    $(use_if alsa --enable-alsa --disable-alsa)
    $(use_if bzip2 --enable-bzip2 --disable-bzip2)
    $(use_if cap-ng --enable-cap-ng --disable-cap-ng)
    $(use_if curl --enable-curl --disable-curl)
    $(use_if curses --enable-curses --disable-curses)
    $(use_if gnutls "--enable-gnutls --enable-nettle" "--disable-gnutls --disable-nettle")
    $(use_if gtk --enable-gtk --disable-gtk)
    $(use_if guest-agent --enable-guest-agent --disable-guest-agent)
    $(use_if vnc "$(use_if jpeg --enable-vnc-jpeg --disable-vnc-jpeg)")
    $(use_if nls --enable-gettext --disable-gettext)
    $(use_if opengl --enable-opengl --disable-opengl)
    $(use_if pipewire --enable-pipewire --disable-pipewire)
    $(use_if png --enable-png --disable-png)
    $(use_if seccomp --enable-seccomp --disable-seccomp)
    $(use_if slirp --enable-slirp --disable-slirp)
    $(use_if tpm --enable-tpm --disable-tpm)
    $(use_if usb --enable-libusb --disable-libusb)
