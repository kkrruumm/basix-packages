pkg_name=dash
version=0.5.13.6
revision=1
build_style=gnu-configure
short_desc="Small and fast POSIX-compliant shell"
home_page="http://gondor.apana.org.au/~herbert/dash/"
license="BSD-3-Clause AND GPL-2.0-or-later"
dist_files="http://gondor.apana.org.au/~herbert/dash/files/dash-${version}.tar.gz"
checksum="ef59d5988dbc441316e807451f02f354994e7b497008c7bea46d9dcbf2c358c5"
register_shell="/usr/bin/dash /bin/dash"

# libedit gives dash interactive line edits and history and shit
# this is off by default because dash is mostly used for scripts
use_flags="man -libedit -static"

depends="$(use_if libedit libedit)"
make_depends="$(use_if libedit libedit)"

configure_args="
    $(use_with libedit)
    $(use_enable static)"

pre_configure() {
    if use static && use libedit; then
        die "dash: static and libedit use flags are mutually exclusive"
    fi
}

post_install() {
    use man || brm /usr/share/man
    bln dash /usr/bin/sh
    blicense COPYING
}
