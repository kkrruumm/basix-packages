pkg_name=s6
version=2.15.1.0
revision=2
_man_rev=1
_man_version=$version.$_man_rev
build_style=configure
short_desc="Process supervision suite"
home_page="https://skarnet.org/software/s6"
license="ISC"
dist_files="https://skarnet.org/software/s6/s6-${version}.tar.gz"

depends="skalibs execline"
make_depends="skalibs execline"

# full: build every program upstream ships instead of just the "default-needed" ones
# i would probably leave this turned off, shit ton of stuff
use_flags="man -static -pkgconfig -doc -full"

# manpages come from an unofficial source, s6 stuff doesnt have manpages officially
dist_files="https://skarnet.org/software/s6/s6-${version}.tar.gz
  $(usev man "https://git.sr.ht/~humm/s6-man-pages/archive/v${_man_version}.tar.gz>s6-man-pages-${_man_version}.tar.gz")"

checksum="0fa40d4cdc39ace536ca40e799fc3ffe51868718beedc1d074aafc315ea3d737
  $(usev man "24da7cf0c801cf7a7bc01362527d9fd483fa15fa3f6af2228407989ead0bf16c")"

# make sure you pay attention to what these are if you fuck with this
# supervision
_s6_progs="s6-svscan s6-supervise s6-svscanctl s6-svc s6-svok s6-svstat
    s6-svwait s6-svlisten s6-setlock s6-notifyoncheck"

# logging
_s6_progs="$_s6_progs s6-log s6-tai64nlocal"

# s6-rcs oneshot runner and s6-linux-inits runleveld/telinit talk over these
# s6-ipcserver and s6-fdholder-daemon run s6-applyuidgid
_s6_progs="$_s6_progs s6-sudo s6-sudoc s6-sudod s6-ipcclient s6-ipcserver
    s6-ipcserverd s6-ipcserver-socketbinder s6-ipcserver-access s6-applyuidgid"

# s6-rc keeps pipes between producers and their loggers in an fdholder
_s6_progs="$_s6_progs s6-fdholder-daemon s6-fdholderd s6-fdholder-retrieve"

# these are s6s chpst equivalents for run scripts, s6-linux-init also
# uses these for a nonroot catch-all logger (s6-setuidgid) and resource limits
# (s6-softlimit)
_s6_progs="$_s6_progs s6-setuidgid s6-envuidgid s6-envdir s6-softlimit"

configure_args="
    --sysconfdir=/etc
    --bindir=/usr/bin
    --libdir=/usr/lib
    --dynlibdir=/usr/lib
    --libexecdir=/usr/libexec
    --includedir=/usr/include
    --with-sysdeps=/usr/lib/skalibs/sysdeps
    --disable-rpath
    --disable-aliases-daemontools
    --disable-aliases-runit
    $(use_if pkgconfig --enable-pkgconfig --disable-pkgconfig)
    $(use_if static --enable-static --disable-static)
    $(use_if static --enable-allstatic --disable-allstatic)
    $(use_if static --disable-shared --enable-shared)"

_s6_make() {
    if use full; then
        $make_cmd "$@"
    else
        # shellcheck disable=SC2086
        $make_cmd BIN_TARGETS="$(printf '%s ' $_s6_progs)" "$@"
    fi
}

do_build() {
    # shellcheck disable=SC2086
    _s6_make $make_jobs
}

do_install() {
    _s6_make DESTDIR="$DESTDIR" install
}

post_install() {
    if use doc; then
        bcopy doc/. "/usr/share/doc/$pkg_name"
    fi

    # would be nice if these were just shipped by default lol
    if use man; then
        _mp=$build_dir/s6-man-pages-v$_man_version
        if use full; then
            ( cd "$_mp" && $make_cmd DESTDIR="$DESTDIR" PREFIX=/usr install )
        else
            # shellcheck disable=SC2086
            for _p in $_s6_progs s6-ftrigrd; do
                if [ -f "$_mp/man8/$_p.8" ]; then bman "$_mp/man8/$_p.8"; fi
            done
            for _p in "$_mp"/man7/*.7; do bman "$_p"; done
        fi
    fi
    blicense COPYING
}
