#!/bin/sh
# the kernel should mount devtmpfs stuff by itself so all this does is
# load the modules that apply to this hardware and fuck off so the
# device manager can pick up
#
# coldplugging doesn't happen here, mdevd-coldplug tells the kernel to reemit
# uevents, the mdevd longrun depends on this oneshot and the mdevd-coldplug oneshot
# depends on the longrun being ready
. /usr/lib/s6-rc/rc.lib
case $1 in
up)
    log "loading modules for present devices..."
    find /sys/devices -name modalias -type f 2>/dev/null | while read -r m; do
        read -r alias < "$m" || continue
        modprobe -bq "$alias" 2>/dev/null || :
    done

    for f in /etc/modules-load.d/*.conf; do
        [ -f "$f" ] || continue
        while read -r mod _; do
            case $mod in ''|\#*) continue ;; esac
            modprobe -bq "$mod" 2>/dev/null || :
        done < "$f"
    done

    # mdevd reads the netlink itself so a hotplug helper left
    # behind by an initramfs needs to be cleaned up
    if [ -w /proc/sys/kernel/hotplug ]; then
        printf '\n' > /proc/sys/kernel/hotplug 2>/dev/null || :
    fi
    ;;
esac
exit 0
