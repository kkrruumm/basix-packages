pkg_name=pinentry
version=1.3.2
revision=1
build_style=gnu-configure
short_desc="Collection of passphrase entry dialogs"
home_page="https://gnupg.org/related_software/pinentry"
license="GPL-2.0-or-later"
dist_files="https://gnupg.org/ftp/gcrypt/pinentry/pinentry-${version}.tar.bz2"
checksum="ee79d79f130955d5e96b94d86ba31c2709ccbe7f0218b38f9a736b68ee3ed498"

depends="libassuan libgpg-error ncurses"
make_depends="libassuan libgpg-error ncurses pkgconf"

configure_args="
    --enable-pinentry-tty
    --enable-pinentry-curses
    --enable-fallback-curses
    --disable-pinentry-qt5
    --disable-pinentry-gtk2
    --disable-pinentry-gnome3
    --disable-pinentry-fltk
    --disable-pinentry-emacs
    --disable-libsecret"

