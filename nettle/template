pkg_name=nettle
version=3.10.2
revision=1
build_style=gnu-configure
short_desc="Low level cryptographic library"
home_page="https://www.lysator.liu.se/~nisse/nettle"
license="LGPL-3.0-or-later OR GPL-2.0-or-later"
dist_files="https://ftp.gnu.org/gnu/nettle/nettle-${version}.tar.gz"
checksum="c6ff393796e76cdcc49b0d825b7f36357f4efc9dc74f4d718b62f347714b944f"

depends="gmp"
make_depends="gmp m4 pkgconf"

# fat builds every x86 assembly variant and picks one at runtime, which is
# what a generic binary package wants
configure_args="
    --enable-fat
    --enable-shared
    --disable-static
    --disable-openssl
    --disable-documentation"

post_install() {
    # nettle writes trailing comments into its .pc fields, which pkgconf
    # carries through into --libs output and confuses configure scripts
    bsed 's/ #.*//' "$DESTDIR/usr/lib/pkgconfig/nettle.pc" \
        "$DESTDIR/usr/lib/pkgconfig/hogweed.pc"
}