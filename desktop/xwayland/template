# this is another package that fucking sucked, btw
pkg_name=xwayland
version=24.1.14
revision=1
build_style=meson
short_desc="X server that runs rootless inside a Wayland compositor"
home_page="https://gitlab.freedesktop.org/xorg/xserver"
license="MIT"
dist_files="https://www.x.org/releases/individual/xserver/xwayland-${version}.tar.xz"
checksum="eff9ea21988bb2c33e8ea0ce1525a96422a95725db7545adb6bbfb1ffd05be0a"
use_flags="glamor -listen_tcp"

depends="libdrm libressl libXfont2 libxcvt libxshmfence mesa pixman wayland
 xkbcomp xkeyboard-config $(use_if glamor libepoxy)"
make_depends="font-util libdrm libressl libxcvt libXfont2 libxkbfile libxshmfence mesa meson
 pixman pkgconf python wayland wayland-protocols xorgproto xtrans
 $(use_if glamor libepoxy)"

configure_args="
    -Dxdmcp=false
    -Dsecure-rpc=false
    -Dsha1=libcrypto
    -Ddri3=true
    -Dglx=true
    -Dxkb_dir=/usr/share/X11/xkb
    -Dxkb_bin_dir=/usr/bin
    -Dxkb_output_dir=/var/lib/xkb
    $(use_if glamor -Dglamor=true -Dglamor=false)
    $(use_if listen_tcp -Dlisten_tcp=true -Dlisten_tcp=false)"

post_install() {
    bmkdir -m 0755 /var/lib/xkb
}
