pkg_name=gnupg
version=2.5.21
revision=1
build_style=gnu-configure
short_desc="GNU Privacy Guard, a complete OpenPGP implementation"
home_page="https://gnupg.org"
license="GPL-3.0-or-later"
dist_files="https://gnupg.org/ftp/gcrypt/gnupg/gnupg-${version}.tar.bz2"
checksum="dc03c1bec123ceeae6da3cf2f758a3070f3bddbb3c326826103c657d9293b312"

use_flags="tls"

depends="bzip2 libassuan libgcrypt libgpg-error libksba npth zlib
 $(use_if tls gnutls)"
make_depends="bzip2 libassuan libgcrypt libgpg-error libksba npth pkgconf zlib
 $(use_if tls gnutls)"

configure_args="
    --disable-nls
    --disable-sqlite
    --disable-tofu
    --disable-card-support
    --disable-ccid-driver
    --disable-ldap
    --disable-ntbtls
    --disable-photo-viewers
    --disable-tests
    --enable-zip
    --enable-bzip2
    $(use_if tls --enable-gnutls --disable-gnutls)"
