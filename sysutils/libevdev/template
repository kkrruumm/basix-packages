pkg_name=libevdev
version=1.14.0
revision=1
build_style=meson
short_desc="Wrapper library for evdev input devices"
home_page="https://www.freedesktop.org/wiki/Software/libevdev/"
license="MIT"
dist_files="https://www.freedesktop.org/software/libevdev/libevdev-${version}.tar.xz"
checksum="d5367929b8188c36f9df7875f7ebf2da175625c7415d9457279471f17d9f31e6"
make_depends="meson pkgconf python"

use_flags="man tools"

# documentation wants doxygen, tools are diagnostic programs nothing needs
configure_args="
    -Dtests=disabled
    -Ddocumentation=disabled
    $(use_if tools -Dtools=enabled -Dtools=disabled)"

post_install() {
    use man || rm -Rf "$DESTDIR/usr/share/man"
}
