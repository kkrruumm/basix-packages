pkg_name=make
version=4.4.1
revision=1
build_style=gnu-configure
short_desc="GNU make"
home_page="https://www.gnu.org/software/make/"
license="GPL-3.0-or-later"
dist_files="https://ftp.gnu.org/gnu/make/make-${version}.tar.gz"
checksum="a7d8aee97b7e9a525ef561afa84eea0d929f246e3aafa420231c0602151cf9eb03"
use_flags="nls static"
use_default="-nls +static"

configure_args="$(use_enable nls)"

pre_configure() {
    CFLAGS="$CFLAGS -std=c17"
    use static && LDFLAGS="$LDFLAGS -static"
    export CFLAGS LDFLAGS
}
