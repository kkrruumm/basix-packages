# this is x86_64 only for the time being
# (the only arch that matters anyway)
pkg_name=qemu
version=11.1.1
revision=1
build_style=configure
short_desc="Generic machine emulator and virtualizer"
home_page="https://www.qemu.org"
license="GPL-2.0-only, LGPL-2.1-only"
dist_files="https://download.qemu.org/qemu-${version}.tar.xz"
checksum="9cda9512c997d0ec176add30ff4f4531d4882681eb12e98ba5c7d11cb4cf610c"

use_flags="slirp curses vnc gnutls png jpeg zstd curl bzip2 aio seccomp usb
 cap-ng xkbcommon gtk opengl alsa tpm
 -pipewire -bridge-helper -guest-agent -i386 -nls"

depends="glib pixman zlib
