pkg_name=openssl
version=4.0.1
revision=1
build_style=custom
short_desc="TLS/SSL and crypto library"
home_page="https://openssl.org"
license="Apache-2.0"
dist_files="https://github.com/openssl/openssl/releases/download/openssl-${version}/openssl-${version}.tar.gz https://github.com/kiss-community/openssl/releases/download/generated/openssl-${version}-generated.tar.gz"
checksum="50266d0787caf4cf6c6fcee71db9dddc3ee071f2e917ea9274068423424efa97 15b0f3c0c16e4935a67f94a9ebb1fca4dabf2a3eee28a35d6d15b6877c529286"
depends="certs"
make_depends="perl"

do_extract() {
    bextract "openssl-$version.tar.gz"
    bextract "openssl-$version-generated.tar.gz" "openssl-$version"
}

do_build() {
    $make_cmd depend
    $make_cmd $make_jobs
}

do_install() {
    $make_cmd DESTDIR="$DESTDIR" install_sw install_ssldirs install_man_docs
    # owned by the certs package
    rmdir "$DESTDIR/etc/ssl/certs" 2>/dev/null || :
}
