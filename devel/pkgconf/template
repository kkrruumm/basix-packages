pkg_name=pkgconf
version=3.0.10
revision=1
build_style=gnu-configure
short_desc="Compiler and linker flag database for libraries"
home_page="https://gitea.treehouse.systems/ariadne/pkgconf"
license="ISC"
dist_files="https://distfiles.ariadne.space/pkgconf/pkgconf-${version}.tar.xz"
checksum="c8930aecddfc2463eb05a35ff140bbf7b4df86de0d30b6bd98046d30f40fc31b"

use_flags="pkg_config_symlink"

post_install() {
    if use pkg_config_symlink; then
        bln pkgconf /usr/bin/pkg-config
    fi
    brm /usr/share/doc
}
