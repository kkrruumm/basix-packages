pkg_name=bubblewrap
version=0.11.2
revision=1
build_style=meson
short_desc="Unprivileged sandboxing tool"
home_page="https://github.com/containers/bubblewrap"
license="LGPL-2.0-or-later"
dist_files="https://github.com/containers/bubblewrap/releases/download/v${version}/bubblewrap-${version}.tar.xz"
checksum="84bbaab8e6674e165401e96d0d3f342015dc043b2528ae30c1da039fb6a06c80"
depends="libcap"
make_depends="libcap meson pkgconf $(use_if man "docbook-xsl libxslt")"

use_flags="man"
use_default="+man"


configure_args="
    -Drequire_userns=true
    -Dtests=false
    $(use_if man -Dman=enabled -Dman=disabled)"

pre_configure() {
    export XML_CATALOG_FILES=/usr/share/xsl/docbook/catalog.xml
}