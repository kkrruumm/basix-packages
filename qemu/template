 $(use_if bzip2 bzip2)
 $(use_if cap-ng libcap-ng)
 $(use_if curl curl)
 $(use_if curses ncurses)
 $(use_if gnutls "gnutls nettle")
 $(use_if gtk gtk3)
 $(use_if vnc "$(use_if jpeg libjpeg-turbo)")
 $(use_if opengl "libdrm libepoxy mesa")
 $(use_if pipewire pipewire)
 $(use_if png libpng)
 $(use_if seccomp libseccomp)
 $(use_if slirp libslirp)
 $(use_if usb libusb)
 $(use_if xkbcommon libxkbcommon)
 $(use_if zstd zstd)"

make_depends="bzip2 glib linux-headers meson pixman pkgconf python
 python-setuptools python-wheel zlib bash
 $(use_if aio libaio)
 $(use_if alsa alsa-lib)
 $(use_if cap-ng libcap-ng)
 $(use_if curl curl)
 $(use_if curses ncurses)
 $(use_if gnutls "gnutls nettle")
 $(use_if gtk "gtk3 xorgproto")
 $(use_if vnc "$(use_if jpeg libjpeg-turbo)")
 $(use_if nls gettext-tiny)
 $(use_if opengl "libdrm libepoxy mesa xorgproto")
 $(use_if pipewire pipewire)
 $(use_if png libpng)
 $(use_if seccomp libseccomp)
 $(use_if slirp libslirp)
 $(use_if usb libusb)
 $(use_if xkbcommon libxkbcommon)
 $(use_if zstd zstd)"

system_groups="$(usev bridge-helper qemu)"
qemu_gid=36

