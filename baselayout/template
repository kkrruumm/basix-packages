pkg_name=baselayout
version=1
revision=3
build_style=custom
short_desc="Base filesystem layout and /etc defaults"
home_page=""
license=""
dist_files="
 https://salsa.debian.org/md/netbase/-/raw/v6.4/etc/services>services-6.4
 https://salsa.debian.org/md/netbase/-/raw/v6.4/etc/protocols>protocols-6.4"
checksum="0e25bf33c6d8eb18e0dd4ba0fcb5995da6fbc6b1f7686f84ddfd73bb4f01e2a7 83b5e58aa5155806fc1dac7deaf8306a12a947f29da0a72fbb1fec265c80443a"

do_install() {
    for d in boot dev etc/modules-load.d etc home mnt opt run usr usr/bin usr/include usr/lib \
             usr/share var/cache var/local var/opt var/log var/log/old \
             var/lib var/lib/misc var/empty var/service var/spool; do
        bmkdir -m 0755 "/$d"
    done
    for d in 1 2 3 4 5 6 7 8; do bmkdir -m 0755 "/usr/share/man/man$d"; done

    bmkdir -m 0555 /proc /sys
    bmkdir -m 0750 /root
    bmkdir -m 1777 /tmp /var/tmp /var/spool/mail

    bln usr/bin /bin
    bln usr/bin /sbin
    bln bin     /usr/sbin
    bln usr/lib /lib
    bln usr/lib /lib64
    bln lib     /usr/lib64

    bln spool/mail        /var/mail
    bln ../run            /var/run
    bln ../run/lock       /var/lock
    bln /proc/self/mounts /etc/mtab

    for f in "$FILESDIR"/*; do
        bconf "$f"
    done

    binstall services-6.4  0644 /etc services
    binstall protocols-6.4 0644 /etc protocols

    # these two carry credentials and must not be world readable
    binstall "$FILESDIR/crypttab" 0600 /etc
    binstall "$FILESDIR/shadow"   0600 /etc
}
