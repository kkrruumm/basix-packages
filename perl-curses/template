pkg_name=perl-curses
version=1.46
revision=2
build_style=perl-module
short_desc="Perl bindings for the curses terminal library"
home_page="https://metacpan.org/dist/Curses"
license="Artistic-1.0-Perl OR GPL-1.0-or-later"
dist_files="https://cpan.metacpan.org/authors/id/G/GI/GIRAFFED/Curses-${version}.tar.gz"
checksum="c7be31e08a4aa1cb98150d9bc1e1e57d425d5ba8a01f3ae421406876dcb1d5f4"
wrk_src="Curses-${version}"
depends="ncurses perl"
make_depends="ncurses perl pkgconf"

pre_configure() {
    CURSES_LIBTYPE="ncursesw"
    CURSES_CFLAGS=$(pkg-config --cflags ncursesw tinfow) || die "pkg-config: no ncursesw"
    CURSES_LDFLAGS=$(pkg-config --libs ncursesw tinfow) || die "pkg-config: no ncursesw"
    export CURSES_LIBTYPE CURSES_CFLAGS CURSES_LDFLAGS
}

post_install() {
    blicense Artistic
}