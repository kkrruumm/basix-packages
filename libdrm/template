pkg_name=libdrm
version=2.4.134
revision=1
build_style=meson
short_desc="Userspace interface to kernel DRM services"
home_page="https://gitlab.freedesktop.org/mesa/libdrm"
license="MIT"
dist_files="https://gitlab.freedesktop.org/mesa/libdrm/-/archive/libdrm-${version}/libdrm-libdrm-${version}.tar.gz"
checksum="4b2f4a35c204ec3e3edd894969e301cf73054c8be5f13d4304a982bdb3b686aef1"
wrk_src="libdrm-libdrm-$version"
depends="libpciaccess libudev-zero"
make_depends="meson pkgconf python-docutils"

use_flags="man intel amdgpu radeon nouveau"
use_default="+man +intel +amdgpu +radeon -nouveau"

# cairo-tests would pull cairo in as a
# build dep for tests nothing runs
configure_args="
    -Dudev=true
    -Dcairo-tests=disabled
    -Dvalgrind=disabled
    -Dinstall-test-programs=false
    $(use_if man -Dman-pages=enabled -Dman-pages=disabled)
    $(use_if intel -Dintel=enabled -Dintel=disabled)
    $(use_if amdgpu -Damdgpu=enabled -Damdgpu=disabled)
    $(use_if radeon -Dradeon=enabled -Dradeon=disabled)
    $(use_if nouveau -Dnouveau=enabled -Dnouveau=disabled)"