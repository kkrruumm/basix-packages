pkg_name=foot
version=1.27.0
revision=2
build_style=meson
short_desc="Fast, lightweight and minimalistic Wayland terminal emulator"
home_page="https://codeberg.org/dnkl/foot"
license="MIT"
dist_files="https://codeberg.org/dnkl/foot/archive/${version}.tar.gz>foot-${version}.tar.gz"
checksum="34f92e0a50ca36b7de72971eddda215b7222462e2c7365e68e9c14961066c718"
wrk_src="foot"
depends="fcft fontconfig freetype libutf8proc libxkbcommon pixman wayland"
make_depends="fcft fontconfig freetype libutf8proc libxkbcommon meson netbsd-curses pixman
 pkgconf scdoc tllist wayland wayland-protocols"

# terminfo is off becuase foots meson target runs `tic -x -o <dir> -e ..`
# and netbsd-curses' tic doesnt have -e or dir output
#
# the foot terminfo (and any future terms shipped in core)
# are kept in netbsd-curses/files/*.terminfo instead
# read: don't turn this on unless you're switching back to ncurses or some shit
use_flags="man -terminfo"

configure_args="
    -Dgrapheme-clustering=enabled
    -Dutmp-backend=none
    $(use_if terminfo -Dterminfo=enabled -Dterminfo=disabled)
    $(use_if man -Ddocs=enabled -Ddocs=disabled)"
