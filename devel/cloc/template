pkg_name=cloc
version=2.10
revision=1
build_style=custom
short_desc="Count lines of code, comment and blank lines by language"
home_page="https://github.com/AlDanial/cloc"
license="GPL-2.0-or-later"
dist_files="https://github.com/AlDanial/cloc/archive/v${version}.tar.gz>cloc-${version}.tar.gz"
checksum="aa310dde77139691ec4cb9294b0925e509b57d07cbfbde3bfc4483d43828505f"
depends="perl"
make_depends="perl"

use_flags="man"

do_build() {
    if use man; then
        make -C Unix man
    fi
}

do_install() {
    bbin cloc

    if use man; then
        bman Unix/cloc.1
    fi

    blicense LICENSE
}
