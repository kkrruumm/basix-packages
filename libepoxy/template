pkg_name=libepoxy
version=1.5.10
revision=2
build_style=meson
short_desc="Library for handling OpenGL function pointer management"
home_page="https://github.com/anholt/libepoxy"
license="MIT"
dist_files="https://download.gnome.org/sources/libepoxy/1.5/libepoxy-${version}.tar.xz"
checksum="0ccee9635115fe417cfc4bc33ffd160bf1e2852bd6c03816b4af771d59462f53"

use_flags="x11"

depends="mesa
  $(use_if x11 libX11)"

make_depends="meson mesa pkgconf python
  $(use_if x11 "libX11 xorgproto")"

configure_args="
    -Dglx=$(use_if x11 yes no)
    -Degl=yes
    -Dx11=$(use_if x11 true false)
    -Dtests=false"