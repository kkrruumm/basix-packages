pkg_name=s6-rc
version=0.7.0.0
revision=1
_man_rev=1
_man_version=$version.$_man_rev
build_style=configure
short_desc="Service manager for the s6 supervision suite"
home_page="https://skarnet.org/software/s6-rc"
license="ISC"

depends="skalibs execline s6"
make_depends="skalibs execline s6"

use_flags="man -static -pkgconfig -doc"

dist_files="https://skarnet.org/software/s6-rc/s6-rc-${version}.tar.gz
  $(usev man "https://git.sr.ht/~humm/s6-rc-man-pages/archive/v${_man_version}.tar.gz>s6-rc-man-pages-${_man_version}.tar.gz")"

checksum="3c286a94184d4343d046e394f905b66d46769275d70e26a3b9169038710d8496 6685c67b701d498694a268bf8fae992029af7bb312a31c2d397dfdd1d9ad7957"

configure_args="
    --sysconfdir=/etc
    --bindir=/usr/bin
    --libdir=/usr/lib
    --dynlibdir=/usr/lib
    --libexecdir=/usr/libexec
    --includedir=/usr/include
    --with-sysdeps=/usr/lib/skalibs/sysdeps
    --bootdb=/etc/s6-rc/compiled/current
    --livedir=/run/s6-rc
    --repodir=/var/lib/s6-rc/repository
    --with-default-bundle=default
    --disable-rpath
    $(use_if pkgconfig --enable-pkgconfig --disable-pkgconfig)
    $(use_if static --enable-static --disable-static)
    $(use_if static --enable-allstatic --disable-allstatic)
    $(use_if static --disable-shared --enable-shared)"

post_install() {
    bmkdir /usr/share/s6-rc/sources /etc/s6-rc/sources
    bmkdir /etc/s6-rc/compiled /var/lib/s6-rc

    if use doc; then
        bcopy doc/. "/usr/share/doc/$pkg_name"
    fi
    
    if use man; then
        _mp=$build_dir/s6-rc-man-pages-v$_man_version
        ( cd "$_mp" && $make_cmd DESTDIR="$DESTDIR" PREFIX=/usr install )
    fi

    blicense COPYING
}
