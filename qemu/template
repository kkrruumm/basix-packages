    --localstatedir=/var
    --libdir=lib
    --libexecdir=/usr/libexec
    --python=/usr/bin/python3
    --target-list=x86_64-softmmu$(usev i386 ,i386-softmmu)
    --disable-download
    --disable-werror
    --disable-debug-info
    --disable-docs
    --disable-linux-user
    --disable-bsd-user
    --disable-modules
    --disable-plugins
    --enable-kvm
    --enable-tcg
    --enable-system
    --enable-tools
    --enable-pie
    --enable-pixman
    --enable-vhost-kernel
    --enable-vhost-net
    --enable-vhost-user
    --enable-vhost-vdpa
    --disable-af-xdp
    --disable-auth-pam
    --disable-blkio
    --disable-bpf
    --disable-brlapi
    --disable-canokey
    --disable-capstone
    --disable-dbus-display
    --disable-fdt
    --disable-gcrypt
    --disable-jack
    --disable-libcbor
    --disable-libdaxctl
    --disable-libdw
    --disable-libiscsi
    --disable-libnfs
    --disable-libpmem
    --disable-libssh
    --disable-libudev
    --disable-linux-io-uring
    --disable-lzo
    --disable-netmap
    --disable-numa
    --disable-oss
    --disable-pa
    --disable-passt
    --disable-rbd
    --disable-rdma
    --disable-rust
