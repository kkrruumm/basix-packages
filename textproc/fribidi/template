pkg_name=fribidi
version=1.0.18
revision=1
build_style=gnu-configure
short_desc="Free implementation of the Unicode bidirectional algorithm"
home_page="https://github.com/fribidi/fribidi"
license="LGPL-2.1-or-later"
dist_files="https://github.com/fribidi/fribidi/releases/download/v${version}/fribidi-${version}.tar.xz"
checksum="b1270c4244a6da13bb18d82b4aff4a413d1ce44cdbd17528931cf9870a7abd64"

use_flags="man"

pre_configure() {
    # fribidi.1 is pregenerated in the tarball but their %.1: % rule always ends up rebuilding
    # this is pretty fucking annoying and changes like every release
    bsed '/^\(@CROSS_COMPILING_FALSE@\)\{0,1\}%\.1: %$/,/--output=\$@$/d' bin/Makefile.in
}

post_install() {
    use man || brm /usr/share/man/man3
}
