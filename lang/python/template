pkg_name=python
version=3.14.8
revision=1
build_style=gnu-configure
short_desc="Python programming language interpreter"
home_page="https://www.python.org"
license="Python-2.0"
dist_files="https://www.python.org/ftp/python/${version}/Python-${version}.tar.xz"
checksum="9fd7b7713a64b221b9f72ce2de5b6997aea36cbc4005561e2921e036e9f8ac6b"
wrk_src="Python-$version"
depends="bzip2 expat libffi libressl zlib"
make_depends="bzip2 expat libffi libressl zlib"

configure_args="
    --enable-shared
    --with-system-expat
    --with-ensurepip=yes"

pre_configure() {
    # _uuid would pull in util-linux
cat >> Modules/Setup <<EOF
*disabled*
_uuid nis ossaudiodev
EOF

    # see patches/libressl.patch
    export ac_cv_working_openssl_hashlib=yes

    # see upstreams PythonNoSemanticInterposition notes
    CFLAGS="$CFLAGS -fno-semantic-interposition"
    LDFLAGS="$LDFLAGS -fno-semantic-interposition"
    export CFLAGS LDFLAGS
}

do_build() {
    $make_cmd $make_jobs EXTRA_CFLAGS="$CFLAGS -DTHREAD_STACK_SIZE=0x100000"
}

post_install() {
    bln python3 /usr/bin/python
    bln pip3 /usr/bin/pip

    # cpythons test stuff
    for _d in "$DESTDIR"/usr/lib/python3*/; do
        rm -rf "$_d"test "$_d"*/test "$_d"*/tests "$_d"idlelib "$_d"turtle*
    done
    rm -f "$DESTDIR"/usr/bin/idle*
}
