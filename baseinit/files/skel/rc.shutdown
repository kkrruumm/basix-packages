#!/bin/sh
# this runs on shutdown/reboot/whatever
# downing services is all that should be in this file, s6-linux-init-shutdownd
# handles unmounting filesystems and actually turning the machine off
. /usr/lib/s6-rc/rc.lib

log "stopping all services..."

# -D goes past flag-essential, -a is every service that is up, so the down
# scripts of the boot oneshots run here, -t so one stuck down script cannot
# hang the shutdown forever (insert non sequitur about systemd here)
s6-rc -v2 -bDa -t 30000 change
