pkg_name=libinput
version=1.32.0
revision=1
build_style=meson
short_desc="Input device library for Wayland and X"
home_page="https://gitlab.freedesktop.org/libinput/libinput"
license="MIT"
dist_files="https://gitlab.freedesktop.org/libinput/libinput/-/archive/${version}/libinput-${version}.tar.gz"
checksum="b6342e131c12c1a8472309c4ced18800084b5aa7815d262f277e01bdbf982d7a"
depends="libevdev libudev-zero mtdev"
make_depends="libevdev libudev-zero meson mtdev pkgconf python"

use_flags="-lua"

# libwacom is tablet support, debug-gui needs gtk, documentation needs sphinx
configure_args="
    -Dmtdev=true
    -Dlibwacom=false
    -Ddebug-gui=false
    -Dtests=false
    -Dinstall-tests=false
    -Ddocumentation=false
    $(use_if lua -Dlua-plugins=enabled -Dlua-plugins=disabled)"
