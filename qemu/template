    $(use_if xkbcommon --enable-xkbcommon --disable-xkbcommon)
    $(use_if zstd --enable-zstd --disable-zstd)"

pre_configure() {
    # alsa isnt in meson.builds default audio driver prio list so
    # every backend that gets built needs to be put here explicitly
    _audio=
    if use alsa; then _audio="$_audio,alsa"; fi
    if use pipewire; then _audio="$_audio,pipewire"; fi
    configure_args="$configure_args --audio-drv-list=${_audio#,}"
}

post_install() {
    if use bridge-helper; then
        binstall "$FILESDIR/bridge.conf" 0640 /etc/qemu
        chown root:36 "$DESTDIR/etc/qemu/bridge.conf"
        chown root:36 "$DESTDIR/usr/libexec/qemu-bridge-helper"
        chmod 4750 "$DESTDIR/usr/libexec/qemu-bridge-helper"
    else
        brm /usr/libexec/qemu-bridge-helper
    fi

    if ! use guest-agent; then
        brm /usr/bin/qemu-ga
    fi

    brm /usr/share/doc
    blicense COPYING
    blicense COPYING.LIB
    return 0
}
