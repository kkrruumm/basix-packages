#!/bin/execlineb -P
# -D 3 is the readiness notification, without it s6-rc wont know that
# mdevd is up and actually being on the netlink and mdevd-coldplug would
# send uevents into the shadow realm
#
# -O 4 rebroadcasts every handled uevent on netlink group 4 which lets
# mdevd-coldplug -O4 block until the last coldplug event
fdmove -c 2 1
mdevd -D 3 -O 4
