pkg_name=libnftnl
version=1.3.2
revision=1
build_style=gnu-configure
short_desc="Low level netlink interface to the nf_tables subsystem"
home_page="https://netfilter.org/projects/libnftnl"
license="GPL-2.0-or-later"
dist_files="https://netfilter.org/projects/libnftnl/files/libnftnl-${version}.tar.xz"
checksum="258bc3ed793cac2a0b6086f1b204878466a6ee78e8c9eff923a5993a11cf997c"

# libnftnls own json parsing is a separate thing from nftables json output,
# nftables talks to jansson directly and does not need this
use_flags="-json"

depends="libmnl $(usev json jansson)"
make_depends="libmnl linux-headers pkgconf $(usev json jansson)"

configure_args="
    --disable-static
    $(use_with json json-parsing)"
