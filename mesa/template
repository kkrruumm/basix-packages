pkg_name=mesa
version=26.1.5
revision=1
build_style=meson
short_desc="Open source implementation of the OpenGL and Vulkan specifications"
home_page="https://www.mesa3d.org"
license="MIT"
dist_files="https://mesa3d.org/archive/mesa-${version}.tar.xz"
checksum="7c127e6df58b173f9d8126cce5f768d82235704c290ae1ba45c3206e1f04b27961"
use_flags="amdgpu intel nouveau rusticl vulkan x11"
use_default="+amdgpu +intel -nouveau -rusticl +vulkan +x11"

depends="expat libdisplay-info libdrm libelf libudev-zero llvm wayland zlib zstd
 $(use_if x11 "libX11 libXdamage libXext libXfixes libXxf86vm libxcb libxshmfence")"
make_depends="bison clang cmake expat flex glslang libclc libdisplay-info libdrm libelf
 libudev-zero llvm meson pkgconf python python-mako python-packaging python-yaml
 spirv-llvm-translator spirv-tools wayland wayland-protocols zlib zstd
 $(use_if x11 "libX11 libXdamage libXext libXfixes libXxf86vm libxcb libxshmfence
 xorgproto")"

configure_args="
    $(use_if x11 -Dplatforms=x11,wayland -Dplatforms=wayland)
    $(use_if x11 -Dglx=dri -Dglx=disabled)
    -Degl=enabled
    -Dgbm=enabled
    -Dopengl=true
    -Dgles1=disabled
    -Dgles2=enabled
    -Dllvm=enabled
    -Dshared-llvm=enabled
    -Ddraw-use-llvm=true
    -Dexpat=enabled
    -Dzstd=enabled
    -Dzlib=enabled
    -Ddisplay-info=enabled
    -Dvalgrind=disabled
    -Dlibunwind=disabled
    -Dlmsensors=disabled
    -Dselinux=false
    -Dbuild-tests=false
    -Dhtml-docs=disabled
    -Dxlib-lease=disabled
    -Dlegacy-x11=disabled
    -Dspirv-tools=enabled"

pre_configure() {
    _gallium=llvmpipe,softpipe
    _vulkan=swrast

    if use amdgpu; then
        _gallium="$_gallium,radeonsi"
        _vulkan="$_vulkan,amd"
    fi
    if use intel; then
        _gallium="$_gallium,iris"
        _vulkan="$_vulkan,intel"
    fi
    if use nouveau; then
        _gallium="$_gallium,nouveau"
        _vulkan="$_vulkan,nouveau"
    fi

    configure_args="$configure_args
        -Dgallium-drivers=$_gallium"

    if use vulkan; then
        configure_args="$configure_args -Dvulkan-drivers=$_vulkan"
    else
        configure_args="$configure_args -Dvulkan-drivers="
    fi

    if use rusticl; then
        configure_args="$configure_args
            -Dgallium-rusticl=true
            -Damd-use-llvm=true"
    else
        configure_args="$configure_args -Dgallium-rusticl=false"
    fi
}