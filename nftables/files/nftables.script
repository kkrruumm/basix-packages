#!/bin/sh
# /usr/lib/s6-rc/scripts/nftables - load and flush the ruleset
. /usr/lib/s6-rc/rc.lib
[ -f /etc/rc.conf ] && . /etc/rc.conf

conf=/etc/nftables.conf

case $1 in
up)
    [ -r "$conf" ] || exit 0
    log "Loading nftables ruleset..."
    nft -f "$conf"
    ;;
down)
    log "Flushing nftables ruleset..."
    nft flush ruleset || :
    ;;
esac
exit 0
