pkg_name=xdg-dbus-proxy
version=0.1.8
revision=1
build_style=meson
short_desc="Filtering proxy for D-Bus connections"
home_page="https://github.com/flatpak/xdg-dbus-proxy"
license="LGPL-2.1-or-later"
dist_files="https://github.com/flatpak/xdg-dbus-proxy/releases/download/${version}/xdg-dbus-proxy-${version}.tar.xz"
checksum="564d6f8ccb45862bb00f136f1a37648c89f2251f358373d73d16102ecaf3c9b3"

use_flags="man"
use_default="+man"

depends="dbus glib"
make_depends="glib meson pkgconf $(use_if man "docbook-xsl libxslt")"

configure_args="
    -Dtests=false
    -Dinstalled_tests=false
    $(use_if man -Dman=enabled -Dman=disabled)"

pre_configure() {
    export XML_CATALOG_FILES=/usr/share/xsl/docbook/catalog.xml
}