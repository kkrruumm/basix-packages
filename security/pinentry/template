pkg_name=pinentry
version=1.3.3
revision=1
build_style=gnu-configure
short_desc="Collection of passphrase entry dialogs"
home_page="https://gnupg.org/related_software/pinentry"
license="GPL-2.0-or-later"
dist_files="https://gnupg.org/ftp/gcrypt/pinentry/pinentry-${version}.tar.bz2"
checksum="49a96d5e6e3cfe57b78a913d1933cb2325139339bbd4845192a060c3bf4a1297"

depends="libassuan libgpg-error ncurses"
