pkg_name=shaderc
version=2026.4
revision=1
build_style=cmake
short_desc="Collection of tools, libraries and tests for shader compilation"
home_page="https://github.com/google/shaderc"
license="Apache-2.0"
dist_files="https://github.com/google/shaderc/archive/v${version}.tar.gz>shaderc-${version}.tar.gz"
checksum="e1613d8aafa35b9bf209ba1ff23d9da5a8948d0f399cf609c19f10f295f17ae9"
depends="glslang spirv-tools"
make_depends="cmake glslang python spirv-headers spirv-tools"

configure_args="
    -DBUILD_SHARED_LIBS=ON
    -DSHADERC_SKIP_TESTS=ON
    -DSHADERC_ENABLE_TESTS=OFF
    -DSHADERC_SKIP_EXAMPLES=ON
    -DSHADERC_SKIP_COPYRIGHT_CHECK=ON
    -Dglslang_SOURCE_DIR=/usr/include/glslang"

pre_configure() {
    bsed '/add_subdirectory(third_party)/d' CMakeLists.txt
    bsed '/add_subdirectory(examples)/d' CMakeLists.txt

    bsed '/add_dependencies(glslc_exe build-version)/d' glslc/CMakeLists.txt

    cat > glslc/src/build-version.inc <<-EOF
	"shaderc ${version}\n"
	"SPIRV-Tools\n"
	"glslang\n"
	EOF
}

post_install() {
    blicense LICENSE
}
