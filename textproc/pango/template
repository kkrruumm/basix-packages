pkg_name=pango
version=1.58.2
revision=1
build_style=meson
short_desc="Library for layout and rendering of internationalized text"
home_page="https://pango.gnome.org"
license="LGPL-2.0-or-later"
dist_files="https://download.gnome.org/sources/pango/${version%.*}/pango-${version}.tar.xz"
checksum="5188d64063c712d0afd4bc51cc8b05e53a5bbaafa8f6e696d65904a0243b6447"
depends="cairo fontconfig freetype glib harfbuzz fribidi"
make_depends="cairo fontconfig freetype fribidi glib harfbuzz meson pkgconf python"

# xft is the X font backend, libthai is thai word breaking
configure_args="
    -Dfontconfig=enabled
    -Dfreetype=enabled
    -Dcairo=enabled
    -Dxft=disabled
    -Dlibthai=disabled
    -Dsysprof=disabled
    -Dintrospection=disabled
    -Ddocumentation=false
    -Dman-pages=false
    -Dbuild-testsuite=false
    -Dbuild-examples=false"
